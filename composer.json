{
  "name": "gazz96/form-builder",
  "description": "A powerful Laravel form builder that allows you to create forms from array or JSON configuration with support for multiple CSS frameworks (Bootstrap 4, Bootstrap 5, Tailwind CSS)",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "form",
    "form-builder",
    "bootstrap",
    "tailwind",
    "html-form"
  ],
  "homepage": "https://github.com/gazz96/form-builder",
  "authors": [
    {
      "name": "Gazz96",
      "email": "bagas.topati@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^10.0|^11.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0|^9.0"
  },
  "autoload": {
    "psr-4": {
      "BagasTopati\\UiCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BagasTopati\\UiCore\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "BagasTopati\\UiCore\\FormBuilderServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}